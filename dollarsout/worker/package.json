{
  "name": "dollarsout-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build:content": "node scripts/build-content.mjs",
    "migrate:remote": "wrangler d1 execute dollarsout-db --remote --file=./migrations/0002_actions_v2.sql",
    "seed:remote": "npm run build:content && wrangler d1 execute dollarsout-db --remote --file=./content/seed_content.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "typescript": "^5.5.4",
    "wrangler": "^4"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2"
  }
}
